rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: news_analyses
    // Document ID: auto-generated
    // Fields:
    //   - uid: string (required) - Owner's UID
    //   - input: string (required) - Original input text
    //   - intent: string (required) - Detected intent
    //   - urgency: string (required, enum: Low, Medium, High)
    //   - summary: string (required) - AI summary
    //   - actions: list (required) - List of strings
    //   - entities: list (optional) - List of strings
    //   - timestamp: number (required) - Creation time
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "kiranda2901@gmail.com" && request.auth.token.email_verified == true));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isValidAnalysis(data) {
      return data.keys().hasAll(['uid', 'input', 'intent', 'urgency', 'summary', 'actions', 'timestamp']) &&
             data.uid is string &&
             data.input is string && data.input.size() < 5000 &&
             data.intent is string && data.intent.size() < 100 &&
             data.urgency in ['Low', 'Medium', 'High'] &&
             data.summary is string && data.summary.size() < 5000 &&
             data.actions is list && data.actions.size() < 20 &&
             data.timestamp is number;
    }

    match /news_analyses/{analysisId} {
      // Users can only read their own analyses, admins can read all
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      
      // Users can only create analyses for themselves
      allow create: if isAuthenticated() && 
                    request.resource.data.uid == request.auth.uid &&
                    isValidAnalysis(request.resource.data);
      
      // Analyses are immutable for now
      allow update: if false;
      
      // Users can delete their own analyses, admins can delete all
      allow delete: if isDocOwner() || isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
